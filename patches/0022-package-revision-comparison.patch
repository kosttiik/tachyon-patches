+
+function to_apk_version(value) {
+    value = as_string(value);
+    let m = match(value, /^(.*)-([0-9]+)$/);
+    return m ? (m[1] + "-r" + m[2]) : value;
+}
+
+function to_opkg_version(value) {
+    value = as_string(value);
+    let m = match(value, /^(.*)-(r|r\.)([0-9]+)$/);
+    return m ? (m[1] + "-" + m[3]) : value;
 }
 
