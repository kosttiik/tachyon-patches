+function dnat_forwards_signature(dnat_forwards) {
+    if (type(dnat_forwards) != "object")
+        return "";
+    return join("|", [
+        join(",", dnat_forwards.tcp_v4 || []),
+        join(",", dnat_forwards.udp_v4 || []),
+        join(",", dnat_forwards.tcp_v6 || []),
+        join(",", dnat_forwards.udp_v6 || [])
+    ]);
+}
