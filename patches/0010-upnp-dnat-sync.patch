+    let dnat_forwards = collect_firewall_dnat_forwards();
+    let new_sig = dnat_forwards_signature(dnat_forwards);
+    let old_sig = trim(as_string(fs.readfile(DNAT_FORWARDS_SIG_FILE) || ""));
+    if (new_sig == old_sig)
+        return true;
+
+    for (let entry in [
+        [ "tachyon_dnat_tcp_v4", dnat_forwards.tcp_v4 ],
+        [ "tachyon_dnat_udp_v4", dnat_forwards.udp_v4 ],
+        [ "tachyon_dnat_tcp_v6", dnat_forwards.tcp_v6 ],
+        [ "tachyon_dnat_udp_v6", dnat_forwards.udp_v6 ]
+    ]) {
+        if (!run_args_quiet([ "nft", "flush", "set", "inet", table, entry[0] ]))
+            return false;
+        if (length(entry[1]) > 0 && !nft_add_set_elements(table, entry[0], join(", ", entry[1])))
+            return false;
+    }
+
+    return common.write_file(DNAT_FORWARDS_SIG_FILE, new_sig + "\n");
+}
