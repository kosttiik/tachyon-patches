+
+function json_contains_string(value, target) {
+    if (type(value) == "string")
+        return value == target;
+    if (type(value) == "array") {
+        for (let item in value)
+            if (json_contains_string(item, target))
+                return true;
+    }
+    else if (type(value) == "object") {
+        for (let key, item in value)
+            if (json_contains_string(item, target))
+                return true;
+    }
+    return false;
+}
+
+function remove_incompatible_vless_leaf(config_path, reason) {
+    reason = as_string(reason || "");
+    if (!match(reason, /parse encryption/))
+        return false;
+    let m = match(reason, /outbound\[([0-9]+)\]/);
+    if (!m)
+        return false;
+
+    let cfg = common.read_json_file(config_path);
+    let index = int(m[1]);
+    if (type(cfg) != "object" || type(cfg.outbounds) != "array" ||
+        index < 0 || index >= length(cfg.outbounds))
+        return false;
+
+    let bad = cfg.outbounds[index];
+    let tag = type(bad) == "object" ? as_string(bad.tag || "") : "";
+    if (type(bad) != "object" || as_string(bad.type || "") != "vless" ||
+        tag == "" || as_string(bad.encryption || "") == "" ||
+        as_string(bad.encryption) == "none")
+        return false;
+
+    let remaining = [];
+    for (let i = 0; i < length(cfg.outbounds); i++) {
+        if (i == index)
+            continue;
+        let outbound = cfg.outbounds[i];
+        if (type(outbound) == "object") {
+            if (as_string(outbound.detour || "") == tag)
+                return false;
+            if (type(outbound.outbounds) == "array") {
+                let members = [];
+                let references_bad = false;
+                for (let member in outbound.outbounds) {
+                    if (as_string(member) == tag)
+                        references_bad = true;
+                    else
+                        push(members, member);
+                }
+                if (references_bad) {
+                    let type_name = as_string(outbound.type || "");
+                    if ((type_name != "selector" && type_name != "urltest") || length(members) == 0)
+                        return false;
+                    outbound.outbounds = members;
+                    if (as_string(outbound.default || "") == tag) {
+                        if (type_name == "selector")
+                            outbound.default = members[0];
+                        else
+                            delete outbound.default;
+                    }
+                }
+            }
+            if (as_string(outbound.default || "") == tag || json_contains_string(outbound, tag))
+                return false;
+        }
+        push(remaining, outbound);
+    }
+
+    let remainder = {};
+    for (let key, value in cfg)
+        if (key != "outbounds")
+            remainder[key] = value;
+    if (json_contains_string(remainder, tag))
+        return false;
+
+    cfg.outbounds = remaining;
+    log_message("sing-box rejected VLESS encryption; excluding only outbound '" + tag +
+        "' and removing its selector/urltest references. The encryption value is preserved in the subscription cache", "warn");
+    return write_file(config_path, sprintf("%J", cfg)) != null;
 }
 
