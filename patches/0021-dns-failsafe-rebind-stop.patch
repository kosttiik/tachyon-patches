+function sing_box_dns_listening() {
+    let udp = fs.readfile("/proc/net/udp") || "";
+    for (let line in split(udp, "\n")) {
+        let fields = split(trim(line), /[ \t]+/);
+        if (length(fields) > 1 && lc(fields[1]) == "2a00007f:0035")
+            return true;
+    }
+    return false;
+}
