+    let now = now_seconds();
+    if (cached_delays_mtime == mtime && cached_delays != null &&
+        cached_delays_at >= 0 && (now - cached_delays_at) < CLASH_DELAYS_CACHE_TTL_S)
+        return cached_delays;
