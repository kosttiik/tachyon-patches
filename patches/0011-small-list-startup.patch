 // nft_add_community_subnet_file_for_section() does further down.
+function community_subnet_file_usable(path) {
+    let data = fs.readfile(path);
+    if (data == null)
+        return false;
+    for (let line in split(as_string(data), /\r?\n/)) {
+        line = trim(line);
+        if (line != "" && substr(line, 0, 1) != "#" && nft_ip_or_cidr(line))
+            return true;
+    }
+    return false;
+}
